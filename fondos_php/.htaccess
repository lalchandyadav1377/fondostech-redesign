# =============================================
# FONDOS TECH — Apache Server & URL Handling (.htaccess)
# =============================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Missing files/folders go to the custom 404 page.
    # Relative to this directory so it works on localhost and banca.fondostech.in.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>
